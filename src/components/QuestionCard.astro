---
// The question's share image (public/quotes/<slug>.jpg, made by scripts/quote-cards/render.mjs),
// full size, with Share and Download. Used on the image page, /quotes/<slug>.
// Class names start with "share-card": the site already uses "question-card" for its
// related-question links, with a side-by-side layout.
interface Props {
  slug: string;
  title: string;
  alt: string;
}
const { slug, title, alt } = Astro.props;
const src = `/quotes/${slug}.jpg`;
const thumb = `/quotes/${slug}-480.jpg`;
---

<figure class="share-card">
  {
    /* The small version paints at once as the background; the full one covers it when it arrives. */
  }
  <img
    class="share-card-image"
    src={src}
    alt={alt}
    width="1080"
    height="1080"
    fetchpriority="high"
    decoding="async"
    style={`background-image:url('${thumb}')`}
  />
  <figcaption class="share-card-actions">
    <button
      type="button"
      class="share-card-button"
      data-card-share={src}
      data-card-name={`${slug}.jpg`}
      data-card-text={title}
    >
      Share image
    </button>
    <a class="share-card-button" href={src} download={`${slug}.jpg`}>Download</a>
    <p class="share-card-status" role="status" aria-live="polite"></p>
  </figcaption>
</figure>

<script>
  // Phones open the share menu only straight from a tap: anything the tap has to wait for
  // (a download) makes Android refuse, so the first tap did nothing. So the picture is fetched
  // once the page's image has loaded (from the browser's cache, no second download) and kept
  // ready; the tap then shares at once. Computers copy the picture; failing that, save it.
  document.querySelectorAll<HTMLButtonElement>("[data-card-share]").forEach((button) => {
    const figure = button.closest("figure")!;
    const img = figure.querySelector("img")!;
    const status = figure.querySelector<HTMLElement>(".share-card-status")!;
    const say = (t: string) => (status.textContent = t);
    const name = button.dataset.cardName!;
    let ready: Blob | null = null;
    let pending: Promise<Blob> | null = null;
    const getBlob = () =>
      ready
        ? Promise.resolve(ready)
        : (pending ||= fetch(button.dataset.cardShare!)
            .then((r) => {
              if (!r.ok) throw new Error(String(r.status));
              return r.blob();
            })
            .then((b) => (ready = b))
            .catch((e) => {
              pending = null;
              throw e;
            }));
    if (img.complete) getBlob().catch(() => {});
    else img.addEventListener("load", () => getBlob().catch(() => {}), { once: true });

    const save = (b: Blob) => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(b);
      a.download = name;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    };
    const isPhone = matchMedia("(pointer: coarse)").matches;

    button.addEventListener("click", async () => {
      say("");
      try {
        if (isPhone && navigator.canShare) {
          if (!ready) {
            // Still downloading: wait for it, then ask for one more tap (the wait used up this one).
            say("Getting the picture…");
            await getBlob();
            return say("Ready. Tap Share image again.");
          }
          const file = new File([ready], name, { type: "image/jpeg" });
          const withLink = { files: [file], text: `${button.dataset.cardText} ${location.href}` };
          if (navigator.canShare(withLink)) return await navigator.share(withLink);
          if (navigator.canShare({ files: [file] }))
            return await navigator.share({ files: [file] });
        }
        if (navigator.clipboard?.write && typeof ClipboardItem !== "undefined") {
          // Clipboards take PNG, not JPEG; the promise keeps the copy tied to this tap.
          const png = getBlob().then(async (b) => {
            const bmp = await createImageBitmap(b);
            const c = document.createElement("canvas");
            c.width = bmp.width;
            c.height = bmp.height;
            c.getContext("2d")!.drawImage(bmp, 0, 0);
            return new Promise<Blob>((res, rej) =>
              c.toBlob((x) => (x ? res(x) : rej(new Error("png"))), "image/png")
            );
          });
          await navigator.clipboard.write([new ClipboardItem({ "image/png": png })]);
          return say("Picture copied. Paste it into your post or chat.");
        }
        save(await getBlob());
        say("Picture saved to your downloads.");
      } catch (e) {
        if ((e as DOMException).name === "AbortError") return;
        try {
          save(await getBlob());
          say("Picture saved to your downloads.");
        } catch {
          say("Couldn’t get the picture. Press and hold it to save it.");
        }
      }
    });
  });
</script>

<style>
  .share-card {
    margin: 0 auto;
    max-width: 540px;
  }
  .share-card-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 6px;
    border: 1px solid var(--surface-border);
    background-size: cover;
  }
  .share-card-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .share-card-button {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border-strong);
    background: var(--surface-bg-muted);
    color: var(--color-link);
    text-decoration: none;
    cursor: pointer;
  }
  .share-card-button:hover {
    background: var(--surface-bg-hover);
    color: var(--color-link-hover);
  }
  .share-card-status {
    flex-basis: 100%;
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .share-card-status:empty {
    display: none;
  }
</style>

---
// The question's quote card (public/quotes/<slug>.jpg, made by scripts/quote-cards/render.mjs),
// with Download and Share. Share sends the picture itself where the browser can (phones),
// otherwise it downloads it.
interface Props {
  slug: string;
  title: string;
}
const { slug, title } = Astro.props;
const src = `/quotes/${slug}.jpg`;
---

<figure class="question-card">
  <a href={src} class="question-card-image">
    <img src={`/quotes/${slug}-480.jpg`} alt={title} width="480" height="480" loading="lazy" />
  </a>
  <figcaption class="question-card-actions">
    <a class="question-card-button" href={src} download={`${slug}.jpg`}>Download image</a>
    <button
      type="button"
      class="question-card-button"
      data-card-share={src}
      data-card-name={`${slug}.jpg`}
      data-card-text={title}
    >
      Share image
    </button>
    <a class="question-card-more" href="/quotes">All images</a>
    <p class="question-card-status" role="status" aria-live="polite"></p>
  </figcaption>
</figure>

<script>
  // Same approach as the books.freely.giving quote page. The picture is fetched when the page
  // loads, because phones only open the share menu straight from a tap: waiting for a download
  // after the tap loses that permission and the menu never opens.
  // Phones: share menu with the picture and a link. Computers: copy the picture. Else: save it.
  document.querySelectorAll<HTMLButtonElement>("[data-card-share]").forEach((button) => {
    const status = button.parentElement!.querySelector<HTMLElement>(".question-card-status")!;
    const say = (t: string) => (status.textContent = t);
    const name = button.dataset.cardName!;
    let blob: Promise<Blob> | null = null;
    const getBlob = () =>
      (blob ||= fetch(button.dataset.cardShare!)
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.blob();
        })
        .catch((e) => {
          blob = null;
          throw e;
        }));
    getBlob().catch(() => {});
    const save = (b: Blob) => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(b);
      a.download = name;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    };
    const isPhone = matchMedia("(pointer: coarse)").matches;
    button.addEventListener("click", async () => {
      say("");
      try {
        if (isPhone && navigator.canShare) {
          const file = new File([await getBlob()], name, { type: "image/jpeg" });
          const withLink = { files: [file], text: `${button.dataset.cardText} ${location.href}` };
          if (navigator.canShare(withLink)) return await navigator.share(withLink);
          if (navigator.canShare({ files: [file] }))
            return await navigator.share({ files: [file] });
        }
        if (navigator.clipboard?.write && typeof ClipboardItem !== "undefined") {
          // Clipboards take PNG, not JPEG; the promise keeps the copy tied to this tap.
          const png = getBlob().then(async (b) => {
            const bmp = await createImageBitmap(b);
            const c = document.createElement("canvas");
            c.width = bmp.width;
            c.height = bmp.height;
            c.getContext("2d")!.drawImage(bmp, 0, 0);
            return new Promise<Blob>((res, rej) =>
              c.toBlob((x) => (x ? res(x) : rej(new Error("png"))), "image/png")
            );
          });
          await navigator.clipboard.write([new ClipboardItem({ "image/png": png })]);
          return say("Picture copied. Paste it into your post or chat.");
        }
        save(await getBlob());
        say("Picture saved to your downloads.");
      } catch (e) {
        if ((e as DOMException).name === "AbortError") return;
        try {
          save(await getBlob());
          say("Picture saved to your downloads.");
        } catch {
          say("Couldn’t get the picture. Press and hold it to save it.");
        }
      }
    });
  });
</script>

<style>
  .question-card {
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    align-items: center;
  }
  .question-card-image img {
    display: block;
    width: 240px;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--surface-border);
  }
  .question-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .question-card-button {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border-strong);
    background: var(--surface-bg-muted);
    color: var(--color-link);
    text-decoration: none;
    cursor: pointer;
  }
  .question-card-button:hover {
    background: var(--surface-bg-hover);
    color: var(--color-link-hover);
  }
  .question-card-more {
    font-size: 0.9rem;
  }
  .question-card-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .question-card-status:empty {
    display: none;
  }
</style>
